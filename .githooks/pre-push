#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SYNC_SCRIPT="${SCRIPT_DIR}/scripts/sync_sessions_to_r2.sh"

if [ ! -x "$SYNC_SCRIPT" ]; then
  echo "[pre-push] sync script not found at $SYNC_SCRIPT, skipping session sync"
  exit 0
fi

if ! command -v wrangler &>/dev/null; then
  echo "[pre-push] wrangler not installed, skipping session sync"
  exit 0
fi

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
  echo "[pre-push] CLOUDFLARE_API_TOKEN not set, skipping session sync"
  exit 0
fi

echo "[pre-push] Syncing Claude sessions to R2..."
timeout 60 "$SYNC_SCRIPT" || echo "[pre-push] Session sync skipped/timed out (push continues)"
