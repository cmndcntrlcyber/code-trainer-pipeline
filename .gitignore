venv
.env
__pycache__
.DS_Store
*.log
*.pid
.wrangler/

# Large binary files — never commit these
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.pkl
*.pickle
*.h5
*.hdf5
*.parquet
*.arrow

# Archives
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.rar

# Training artifacts
models/
wandb/
data/hf_dataset_multimodal/

# Collected data — cloned repos, SQLite catalogs, captures, HF datasets
data/captures/
data/repositories/
data/pdf_captures/
data/catalog.db
data/hf_dataset/
data/sample-data/
data/offensive-security/
# Nested captures/repos/catalogs under any data subdirectory
data/**/captures/
data/**/repositories/
data/**/catalog.db
data/inputs/*
data/outputs/*
!data/inputs/.gitignore
!data/outputs/.gitignore

# Mixed datasets (live on HuggingFace Hub, not GitHub)
data/v7_mixed/
data/v8_mixed/
data/v9_mixed/

# Claude session transcripts — private CoT/RL training data
data/cot_rl_sessions/*
!data/cot_rl_sessions/.gitkeep

# Abliteration / GGUF working directories
data/gguf_work/
data/abliterated/

# Sweep & validation results (regenerated from HF Jobs)
data/sweep_results/
data/v*_validation/
